#!/bin/bash
set -uo pipefail
result=0
check() { "$@" || result=1; }
echo "$(date -Is) health check"
check systemctl is-active samba-ad-dc chrony
check samba-tool dbcheck --cross-ncs
check samba-tool drs showrepl {{ inventory_hostname }} -A /etc/samba-ad/admin.auth --use-kerberos=required
check samba-tool ntacl sysvolcheck
check chronyc tracking
check runuser -u _chrony -- test -w /var/lib/samba/ntp_signd/socket
check openssl x509 -in /etc/samba/tls/server.crt -checkend 2592000 -noout
check timeout 10 openssl s_client -connect {{ samba_ad_ipv4 }}:636 -servername {{ inventory_hostname }} -verify_hostname {{ inventory_hostname }} -verify_return_error -CAfile /etc/samba/tls/ca.crt </dev/null
for query in _ldap._tcp.dc._msdcs.{{ samba_ad_domain }} _kerberos._tcp.{{ samba_ad_domain }}; do
  records=$(dig @{{ samba_ad_ipv4 }} "$query" SRV +short)
  [[ -n "$records" ]] || result=1
  echo "$records"
done
client_records=$(dig @{{ samba_ad_client_resolver }} _ldap._tcp.dc._msdcs.{{ samba_ad_domain }} SRV +short +time=2 +tries=1)
if [[ -z "$client_records" ]]; then
  echo 'WARNING: client resolver {{ samba_ad_client_resolver }} cannot discover AD; client rollout is blocked'
fi
# showrepl may exit zero even if an individual replication neighbour failed.
if samba-tool drs showrepl {{ inventory_hostname }} -A /etc/samba-ad/admin.auth --use-kerberos=required | grep -E 'consecutive failure\(s\)|Last attempt.*failed' | grep -v '0 consecutive failure(s)'; then result=1; fi
if (( $(df --output=pcent /var/lib/samba | tail -1 | tr -dc '0-9') >= 85 )); then
  echo 'ERROR: Samba filesystem at least 85% full'; result=1
fi
if ! find /var/log/samba-ad -name sysvol-last-success -mmin -5 | grep -q .; then
  echo 'ERROR: SYSVOL synchronization stale'; result=1
fi
if ! find /var/log/samba-ad -name backup-last-success -mmin -1560 | grep -q .; then
  echo 'ERROR: no successful backup in last 26 hours'; result=1
fi
echo "$(date -Is) result=$result"
exit "$result"
